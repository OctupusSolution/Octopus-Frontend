# Backend has no CORS configured, so the dev server proxies /api/* to
# PublicApi instead of the browser calling it directly (see next.config.mjs).
# Frontend code must call fetch("/api/v1/...") — never this URL directly.
PUBLIC_API_URL=http://localhost:8082

# GET /v1/public-site resolves the tenant from the Host header's subdomain
# (<slug>.<this suffix>) — app/api/public-site/route.ts fakes that header
# locally using the same tenant slug the rest of the app already falls back
# to (x-tenant-slug / "burger-house"). Must match the backend's
# Platform:BaseDomainSuffix.
DEV_TENANT_DOMAIN_SUFFIX=octopus.app
