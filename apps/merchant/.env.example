# Backend has no CORS configured, so the dev server proxies /api/* to
# AdminApi instead of the browser calling it directly (see vite.config.ts).
# Frontend code must call fetch("/api/v1/...") — never this URL directly.
ADMIN_API_URL=http://localhost:8081

# Where the storefront's menu canvas (/preview/menu) is served for the menu builder's live preview.
# Default: http://localhost:3000 in development, https://menu.octopus.sa in production.
VITE_STOREFRONT_CANVAS_ORIGIN=
